{
  "manifest_version": 3,
  "name": "Meta-Gen VCPA - AI Image to Prompt Assistant",
  "version": "1.1.0",
  "description": "Deteksi gambar di semua web, generate prompt AI (VCPA), dan kirim prompt ke Google Flow untuk auto-gen gambar.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "debugger",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://labs.google/*",
    "https://flow.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["agent-floater.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://labs.google/*",
        "https://flow.google.com/*"
      ],
      "js": ["flow-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meta-Gen VCPA Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
